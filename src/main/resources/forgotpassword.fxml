<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane prefHeight="750.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.ResetPasswordController">
    <children>
        <!-- Background Image with Overlay -->
        <ImageView fitHeight="750.0" fitWidth="1000.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@Image/campus.png" />
            </image>
        </ImageView>
        
        <!-- Dark overlay -->
        <Region prefHeight="750" prefWidth="1000" style="-fx-background-color: rgba(0,0,0,0.3);"/>

        <!-- Modern Reset Password Card -->
        <VBox alignment="CENTER" layoutX="350.0" layoutY="100.0" prefHeight="550.0" prefWidth="300.0" spacing="25" 
              style="-fx-background-color: rgba(255,255,255,0.98); -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 5); -fx-padding: 40;">
            
            <!-- Header -->
            <VBox spacing="5" alignment="CENTER">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" text="Reset Password" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Verify your information" />
            </VBox>

            <!-- Username Section (Visible initially) -->
            <VBox fx:id="usernamePane" alignment="CENTER_LEFT" spacing="10" prefWidth="220.0">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Username" />
                <TextField fx:id="usernameField" promptText="Enter your username" 
                           style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                <Button fx:id="verifyUsernameBtn" onAction="#handleVerifyUsername" 
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-padding: 12 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 8, 0, 0, 2);" 
                        text="Continue >" />
            </VBox>

            <!-- Verification Section (Hidden initially) -->
            <VBox fx:id="verificationPane" alignment="CENTER_LEFT" spacing="12" prefWidth="220.0" visible="false" managed="false">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Registered Email" />
                <TextField fx:id="emailField" promptText="Enter your email" 
                           style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Registered Age" />
                <TextField fx:id="ageField" promptText="Enter your age" 
                           style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                <Button fx:id="verifyInfoBtn" onAction="#handleVerifyInfo" 
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-padding: 12 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 8, 0, 0, 2);" 
                        text="Verify Information" />
            </VBox>

            <!-- Message Label -->
            <Label fx:id="messageLabel" style="-fx-font-size: 12px; -fx-text-fill: red; -fx-font-weight: bold; -fx-wrap-text: true; -fx-alignment: center;" text="" />

            <!-- New Password Form (Hidden initially) -->
            <VBox fx:id="newPasswordPane" alignment="CENTER_LEFT" spacing="10" prefWidth="220.0" visible="false" managed="false">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="New Password" />
                <PasswordField fx:id="newPasswordField" promptText="Enter new password" 
                                style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
            </VBox>

            <!-- Confirm New Password (Hidden initially) -->
            <VBox fx:id="confirmPasswordPane" alignment="CENTER_LEFT" spacing="10" prefWidth="220.0" visible="false" managed="false">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Confirm New Password" />
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter new password" 
                                style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
            </VBox>

            <!-- Submit Button (Hidden initially) -->
            <Button fx:id="submitBtn" onAction="#handleSubmit" 
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 10; -fx-padding: 12 30; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 8, 0, 0, 2);" 
                    text="Reset Password" visible="false" managed="false"/>
            
            <!-- Back to Login Link -->
            <Button onAction="#handleBackToLogin" 
                    style="-fx-background-color: transparent; -fx-text-fill: #3b82f6; -fx-font-size: 13px; -fx-underline: false; -fx-cursor: hand;" 
                    text="← Back to Login" />
        </VBox>
    </children>
</AnchorPane>
