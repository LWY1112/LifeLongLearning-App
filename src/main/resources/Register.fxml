<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="750.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.RegisterController">
    <children>
        <!-- Background Image with Overlay -->
        <ImageView fitHeight="800.0" fitWidth="1000" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@Image/campus.png" />
            </image>
        </ImageView>
        
        <!-- Dark overlay -->
        <Region prefHeight="750" prefWidth="1000" style="-fx-background-color: rgba(0,0,0,0.3);"/>

        <!-- Modern Registration Form - Larger and Centered -->
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" 
                    AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="30" AnchorPane.leftAnchor="300" AnchorPane.rightAnchor="300"
                    style="-fx-background: transparent; -fx-background-color: transparent;" 
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox alignment="CENTER_LEFT" spacing="20" 
                      style="-fx-background-color: rgba(255,255,255,0.98); -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 5);"
                      minWidth="380">
                    
                    <!-- Header -->
                    <VBox spacing="8">
                        <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" text="Create Account" />
                        <Label style="-fx-font-size: 15px; -fx-text-fill: #64748b;" text="Join PathLearner today" />
                    </VBox>

                    <!-- Form Fields -->
                    <VBox spacing="18" prefWidth="300.0" minWidth="300">
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Full Name" />
                            <TextField fx:id="nameField" promptText="Enter your full name" 
                                       style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Phone" />
                            <TextField fx:id="phoneField" promptText="Enter your phone number" 
                                       style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Email" />
                            <TextField fx:id="emailField" promptText="Enter your email" 
                                       style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Age" />
                            <TextField fx:id="ageField" promptText="Enter your age" 
                                       style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Username" />
                            <TextField fx:id="usernameField" promptText="Choose a username" 
                                       style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Password" />
                            <PasswordField fx:id="passwordField" promptText="Create a password" 
                                            style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Confirm Password" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" 
                                            style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-font-size: 14px;" />
                        </VBox>

                        <Button fx:id="registerBtn" onAction="#handleRegister" 
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 14 35; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 8, 0, 0, 2);" 
                                text="Sign Up" />
                    </VBox>

                    <!-- Back to Login -->
                    <HBox spacing="5" alignment="CENTER">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Already have an account?" />
                        <Hyperlink onAction="#handleBackToLogin" 
                                   style="-fx-font-size: 14px; -fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-underline: false; -fx-cursor: hand;" 
                                   text="Sign In" />
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
